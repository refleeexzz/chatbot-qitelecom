        "body": { "mode": "raw", "raw": "{\n  \"message\": \"Teste header injection\"\n}" },
        "url": { "raw": "http://localhost:8081/chatbot", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["chatbot"] }
      }
    },
