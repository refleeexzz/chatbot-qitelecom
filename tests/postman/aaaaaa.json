            },
            "url": "{{baseUrl}}/chatbot"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Tem menu', () => ['[1]','[2]','[3]','[4]'].every(o=>r.response.includes(o)));"
                ],
                "type": "text/javascript"
              }
            }
