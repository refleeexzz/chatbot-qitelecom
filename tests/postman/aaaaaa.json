      "name": "Health",
      "item": [
        {
          "name": "GET Health",
            "request": {
              "method": "GET",
              "header": [],
              "url": "{{baseUrl}}/health"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', ()=> pm.response.code === 200);"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
        }
      ]
    },
    {
